{
  "preset": "ts-jest",
  "moduleNameMapper": {
    "\\.(css|less|scss|sass)$": "identity-obj-proxy"
  },
  "moduleFileExtensions": [
    "ts",
    "tsx",
    "js",
    "jsx",
    "json",
    "node"
  ],
  "setupFilesAfterEnv": [
    "<rootDir>/tests/setup.ts"
  ],
  "testEnvironment": "jsdom",
  "transform": {
    "^.+\\.[t|j]sx?$": "babel-jest"
  }
}
